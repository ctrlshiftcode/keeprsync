{
  "manifest_version": 3,
  "name": "KeeprSync",
  "version": "0.1.3",
  "key": "",
  "description": "Sync Chrome bookmarks across computers with Google Drive.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "760604765265-22fvvefb8ithk64v94e6ohv4npn4dar3.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_title": "Open KeeprSync",
    "default_popup": 
    "src/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}